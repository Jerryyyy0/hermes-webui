# Hermes Web UI -- local machine config template
# Copy this to .env and fill in your values.
# start.sh sources .env automatically if present.
# All values are optional -- auto-discovery will fill in anything left blank.

# Path to your hermes-agent checkout (the repo that contains run_agent.py)
# HERMES_WEBUI_AGENT_DIR=/path/to/hermes-agent

# Python executable to use (defaults to the agent venv if found)
# HERMES_WEBUI_PYTHON=/path/to/python

# Bind address (default: 127.0.0.1 -- loopback only, safe default)
# HERMES_WEBUI_HOST=127.0.0.1

# Port to listen on (default: 8787)
# HERMES_WEBUI_PORT=8787

# Where to store sessions, workspaces, and other state (default: ~/.hermes/webui)
# HERMES_WEBUI_STATE_DIR=~/.hermes/webui

# Default workspace directory shown on first launch
# HERMES_WEBUI_DEFAULT_WORKSPACE=~/workspace

# Max workspace file read / manifest preview size in MB (default: 10)
# HERMES_WEBUI_MAX_FILE_MB=10

# Max chat attachment / workspace upload size in MB (default: 50)
# HERMES_WEBUI_MAX_UPLOAD_MB=50

# Optional model override. Leave unset to use the active Hermes provider default.
# HERMES_WEBUI_DEFAULT_MODEL=

# Base directory for all Hermes state (affects all paths above if set)
# HERMES_HOME=~/.hermes

# Path to your Hermes config.yaml (for toolsets and model config)
# HERMES_CONFIG_PATH=~/.hermes/config.yaml

# Display name for the assistant in the UI (default: Hermes)
# HERMES_WEBUI_BOT_NAME=Hermes

# Integration layer (see integration/README.md)
# HERMES_INTEGRATION=1                 # profile enrich, integration UI scripts, Cron Hub
# SKILLHUB_URL=http://127.0.0.1:8000   # optional; SkillHub market requires HERMES_INTEGRATION=1
# ZHILING_CONTROL_PLANE_URL=http://zhiling-control-plane:13001  # optional; GET /api/integration/webui_login
# ZHILING_IDENTITY_CACHE_TTL_SECONDS=1800                        # optional; in-process identity cache TTL when JWT exp absent
# ZHILING_LOGOUT_API_URL=http://auth-proxy:8080                  # optional; auth-proxy origin only (path /api/logout is fixed in code)
# KNOWLEDGE_BASE_URL=http://192.168.1.132:17861                  # optional; knowledge base BFF proxy requires HERMES_INTEGRATION=1
# Profile logo: copy integration/profiles/info.json.example to each profile dir as info.json

# Remote browser preview (noVNC / Camofox viewer iframe + browser_preview SSE)
# BROWSER_PREVIEW_URL=http://192.168.1.139:6080/vnc.html?path=websockify?token=user1
# BROWSER_PREVIEW_DELAY_SECONDS=5   # async delay before browser_preview SSE (0 = immediate)
